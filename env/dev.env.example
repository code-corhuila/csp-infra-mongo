# Names and placeholders only (Annex J.5.1). Copy to env/dev.env, which is git-ignored, and fill it in.
# Development: values may be local and throwaway.
COMPOSE_PROJECT_NAME=csp-dev

# The single MongoDB instance. The administrator exists only to create the instance and its login users.
MONGO_ADMIN_USER=mongo_admin
MONGO_ADMIN_PASSWORD=
# Key file of the single-node replica set rs0: one line of base64, e.g. openssl rand -base64 48 | tr -d '\n'
MONGO_KEYFILE=
MONGO_HOST=mongodb

# Login users of the domains: created by mongo/init/01-instance.js, used by the -db executor and the services.
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=
WORKER_APP_PASSWORD=
