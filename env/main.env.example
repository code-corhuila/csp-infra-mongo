# Names and placeholders only (Annex J.5.1). Copy to env/main.env, which is git-ignored, and fill it in.
# main: the values come from the secrets of the environment. Never run 'docker compose down -v' here (J.5.4); back up the volume before migrating.
COMPOSE_PROJECT_NAME=csp-main

# The single MongoDB instance. The administrator exists only to create the instance and its login users.
MONGO_ADMIN_USER=mongo_admin
MONGO_ADMIN_PASSWORD=
# Key file of the single-node replica set rs0: one line of base64, e.g. openssl rand -base64 48 | tr -d '\n'
MONGO_KEYFILE=
MONGO_HOST=mongodb

# Login users of the domains: created by mongo/init/01-instance.js, used by the -db executor and the services.
CATALOG_DB_NAME=catalog_db
# The migrator: the login of the catalog-db-migrate executor (owner of catalog_db). The API has its own login below.
CATALOG_DB_USER=catalog_migrator
CATALOG_DB_PASSWORD=
CATALOG_APP_PASSWORD=
WORKER_APP_PASSWORD=
